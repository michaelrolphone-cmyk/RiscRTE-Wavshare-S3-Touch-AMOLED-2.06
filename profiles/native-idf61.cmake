# Native successor of the exact Runtime4107 expanded + .44 performance profile,
# retained by published Waveshare0.1.48. No partition or settings identity change.
set(RISC_NATIVE_TARGET "esp32s3-16mb-waveshare-expanded")
set(RISC_NATIVE_PARTITIONS "${RISC_RUNTIME_ROOT}/partitions-paired-appdata-expanded.csv")
set(RISC_NATIVE_SETTINGS_HEADER "${CMAKE_CURRENT_LIST_DIR}/native-idf61-settings.h")
set(RISC_NATIVE_EXTRA_SOURCES "${CMAKE_CURRENT_LIST_DIR}/../native/VendorDisplay.cpp")
set(RISC_NATIVE_APPDATA ON)
set(RISC_NATIVE_IQ ON)
set(RISC_NATIVE_DEFINITIONS
    RISC_PAIRED_BANKS=1 RISC_PAIRED_APP_DATA=1 RISC_PAIRED_APP_DATA_EXPANDED=1
    RISC_ENABLE_HTTP=1 RISC_ENABLE_SDMMC=1 RISC_ENABLE_USB_PHY=1
    RISC_ENABLE_RADIO_IQ=1 RISC_NATIVE_TCP_LISTENER=1 RISC_NATIVE_ENTROPY=1
    RISC_INSTALLED_APP_CAPACITY=64 RISC_PROVIDER_CAPACITY=40
    RISC_APP_POLICY_ROWS=32 RISC_APP_REQUIREMENT_ROWS=32 RISC_STAGE_LOGS=1
    RISC_NATIVE_RECOVERY_GPIO=1 RISC_RECOVERY_GPIO_PIN=0 RISC_RECOVERY_GPIO_ACTIVE_HIGH=0
    RISC_NATIVE_FILE_SOURCE=1 RISC_NATIVE_APP_DATA_MOUNT=1
    RISC_NATIVE_SETTINGS_BACKEND=1 RISC_NATIVE_SETTINGS_STARTUP_ENTROPY=1
    RISC_NATIVE_SETTINGS_ASSEMBLY=1 RISC_NATIVE_SETTINGS_PSRAM_PAYLOAD=1
    RISC_NATIVE_SETTINGS_LIFECYCLE=1 RISC_NATIVE_SETTINGS_WORKER=1
    RISC_RUNTIME_ATOMIC_KEY_VALUE=1 RISC_NATIVE_STORAGE_CUSTODY=1
    RISC_PERFORMANCE_TRACE=1 RISC_PERFORMANCE_TRACE_CAPACITY=64)
set(RISC_NATIVE_LINK_OPTIONS
    "-Wl,-u,risc_paired_store_abi" "-Wl,-u,risc_runtime_update_version"
    "-Wl,-u,risc_usb_phy_resource_enabled" "-Wl,-u,risc_sdmmc_host_abi"
    "-Wl,-u,risc_tcp_listener_abi" "-Wl,-u,risc_entropy_abi"
    "-Wl,-u,risc_file_source_abi" "-Wl,-u,__wrap_esp_littlefs_format"
    "-Wl,-u,__wrap_esp_littlefs_format_partition")
